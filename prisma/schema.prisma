generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  YONETICI
  TASARIM
  URETIM
  MONTAJ
  MUHASEBE
}

enum Stage {
  KESIF
  TASARIM
  URETIM
  MONTAJ
  TAHSILAT
}

enum ApprovalStatus {
  BEKLIYOR
  ONAYLANDI
  REVIZYON
}

enum PaymentStatus {
  BEKLIYOR
  KISMI
  TAMAMLANDI
}

enum CustomerType {
  FIRMA
  SAHIS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
}

model Job {
  id          String          @id @default(cuid())
  code        String          @unique
  client      String
  description String
  stage       Stage           @default(KESIF)
  material    String?
  cost        Float?
  dueDate     DateTime?
  overdue     Boolean         @default(false)
  assignee    String?
  payStatus   PaymentStatus   @default(BEKLIYOR)
  approval    ApprovalStatus?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// Kişiler (Müşteri/Firma) — Teklifler ve Görev Yönetimi bu tabloya bağlanır
model Customer {
  id             String       @id @default(cuid())
  type           CustomerType @default(FIRMA)
  name           String       // Firma Adı ya da Ad Soyad
  contact        String?      // Yetkili kişi (firma ise)
  phone          String?
  email          String?
  address        String?
  kaynak         String?
  kampanya       String?
  temsilci       String?
  sektor         String?
  etiket         String?
  kisaAciklama   String?
  hatirlatma     String?
  contactRows    Json?        // [{type, value}] - çoklu telefon/e-posta
  addressRows    Json?        // [{type, country, postal, ilce, sehir, eyalet, detail}]
  faturaUnvani   String?
  vergiNo        String?
  vergiDairesi   String?
  faturaAdresi   String?
  fPostaKodu     String?
  fIlce          String?
  fSehir         String?
  fUlke          String?
  vadeGun        Int?
  calisanSayisi  Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
