generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  YONETICI
  TASARIM
  URETIM
  MONTAJ
  MUHASEBE
}

// Giriş hesapları. Şifre asla düz metin tutulmaz (bcrypt hash).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
}

// Uygulamanın tüm verisi (kişiler, teklifler, işler, plan, ön muhasebe, araçlar…)
// tek bir JSON belgesinde tutulur. `version` her kayıtta 1 artar; eski bir sürümün
// üzerine yazma denemesi 409 ile reddedilir (iki cihaz aynı anda kaydederse).
model AppState {
  id        String   @id @default("main")
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  updatedBy String?
}
